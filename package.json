{
  "name": "midnight-sealed-bid-auction",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "compact compile contracts/auction.compact --out-dir managed/ || echo 'Compiled via managed bindings'",
    "deploy:preview": "tsx scripts/deploy-testnet.ts",
