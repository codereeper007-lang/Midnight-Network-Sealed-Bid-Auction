import CompactStandardLibrary;

export ledger commitments: Map<Bytes<32>, Boolean>;
export ledger highestBid: Uint<64>;
export ledger winner: Bytes<32>;
export ledger isOpen: Boolean;
export ledger totalBids: Counter;
export ledger minReserveBid: Uint<64>;
export ledger auctioneer: Bytes<32>;

witness getBidAmount(): Uint<64>;
witness getBidderSecret(): Bytes<32>;
witness getBidderAddress(): Bytes<32>;

constructor(reserve: Uint<64>, adminPubKey: Bytes<32>) {
  isOpen = true;
  totalBids.increment(0);
  minReserveBid = disclose(reserve);
  highestBid = 0;
  winner = pad(32, "");
  auctioneer = disclose(adminPubKey);
}

export circuit place_bid(commitment: Bytes<32>): [] {
  assert(isOpen, "Auction is currently closed");
  assert(!commitments.member(disclose(commitment)), "Bid commitment has already been registered");
  commitments.insert(disclose(commitment), true);
  totalBids.increment(1);
}

export circuit reveal_bid(): [] {
  assert(isOpen, "Auction is currently closed");
  const amount: Uint<64> = getBidAmount();
  const secret: Bytes<32> = getBidderSecret();
  const bidder: Bytes<32> = getBidderAddress();

  assert(amount >= minReserveBid, "Bid amount is strictly below the required minimum reserve");

  const computedCommitment: Bytes<32> = persistentHash<Vector<2, Bytes<32>>>([
    secret,
    persistentHash<Uint<64>>(amount)
  ]);

  assert(commitments.member(disclose(computedCommitment)), "Invalid reveal: Commitment does not exist in registered bids");

  if (disclose(amount > highestBid)) {
    highestBid = disclose(amount);
    winner = disclose(bidder);
  }
}

export circuit close_auction(): [] {
  isOpen = false;
}

